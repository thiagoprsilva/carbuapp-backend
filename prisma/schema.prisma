generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Oficina {
  id          Int       @id @default(autoincrement())
  nome        String
  responsavel String
  telefone    String
  endereco    String
  logoUrl     String?   // caminho relativo: "logos/oficina-1.png"
  createdAt   DateTime  @default(now())

  usuarios    Usuario[]
  clientes    Cliente[]
  veiculos    Veiculo[]
  registros   RegistroTecnico[]
  orcamentos  Orcamento[]
}

model Usuario {
  id         Int      @id @default(autoincrement())
  nome       String
  email      String   @unique
  senha      String
  role       String   // "superadmin" | "admin" | "mecanico"
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())

  // null apenas para o superadmin global (sem vínculo com oficina)
  oficinaId  Int?
  oficina    Oficina? @relation(fields: [oficinaId], references: [id])
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nome      String
  telefone  String?
  createdAt DateTime @default(now())

  oficinaId Int
  oficina   Oficina  @relation(fields: [oficinaId], references: [id])

  veiculos  Veiculo[]
}

model Veiculo {
  id          Int      @id @default(autoincrement())
  placa       String
  modelo      String
  ano         String?
  motor       String?
  alimentacao String?
  createdAt   DateTime @default(now())

  clienteId   Int
  cliente     Cliente  @relation(fields: [clienteId], references: [id])

  oficinaId   Int
  oficina     Oficina  @relation(fields: [oficinaId], references: [id])

  registros   RegistroTecnico[]
  orcamentos  Orcamento[]
}

// ─── Ordem de Serviço (OS central) ──────────────────────────────────────────
model RegistroTecnico {
  id          Int      @id @default(autoincrement())
  numero      Int
  status      String   @default("Aberta")
  // Valores: "Aberta" | "Em andamento" | "Aguardando peças" | "Concluída" | "Cancelada"
  categoria   String
  descricao   String
  dataServico DateTime
  observacoes String?
  createdAt   DateTime @default(now())

  veiculo     Veiculo  @relation(fields: [veiculoId], references: [id])
  veiculoId   Int

  oficina     Oficina  @relation(fields: [oficinaId], references: [id])
  oficinaId   Int

  // filhos da OS
  laudo       LaudoEntrada?
  fotos       Foto[]
  orcamentos  Orcamento[]

  @@unique([oficinaId, numero])
}

// ─── Orçamento (sempre filho de uma OS) ─────────────────────────────────────
model Orcamento {
  id        Int      @id @default(autoincrement())
  numero    Int
  status    String   @default("Pendente")
  // Valores: "Pendente" | "Aprovado" | "Rejeitado" | "Executado"
  subtotal  Float?
  total     Float?
  createdAt DateTime @default(now())

  veiculoId Int
  veiculo   Veiculo  @relation(fields: [veiculoId], references: [id])

  oficinaId Int
  oficina   Oficina  @relation(fields: [oficinaId], references: [id])

  registroTecnicoId Int
  registroTecnico   RegistroTecnico @relation(fields: [registroTecnicoId], references: [id])

  itens     OrcamentoItem[]

  @@unique([oficinaId, numero])
}

model OrcamentoItem {
  id           Int     @id @default(autoincrement())
  descricao    String
  qtd          Int
  precoUnit    Float?
  valorLinha   Float?

  orcamentoId  Int
  orcamento    Orcamento @relation(fields: [orcamentoId], references: [id])
}

// ─── Laudo de entrada (pertence à OS, não ao orçamento) ─────────────────────
model LaudoEntrada {
  id                Int             @id @default(autoincrement())
  km                Int?
  nivelCombust      String?         // "1/4" | "1/2" | "3/4" | "cheio"
  observacoes       String?
  criadoEm          DateTime        @default(now())

  registroTecnicoId Int             @unique
  registroTecnico   RegistroTecnico @relation(fields: [registroTecnicoId], references: [id])

  avarias           AvariaItem[]
}

model AvariaItem {
  id         Int          @id @default(autoincrement())
  zona       String       // "capo" | "porta_diant_e" | "teto" | etc.
  severidade String?      // "leve" | "moderado" | "grave"
  observacao String?

  laudoId    Int
  laudo      LaudoEntrada @relation(fields: [laudoId], references: [id], onDelete: Cascade)
}

// ─── Fotos (pertencem à OS, não ao orçamento) ────────────────────────────────
model Foto {
  id                Int             @id @default(autoincrement())
  url               String
  descricao         String?
  zona              String?
  criadoEm          DateTime        @default(now())

  registroTecnicoId Int
  registroTecnico   RegistroTecnico @relation(fields: [registroTecnicoId], references: [id])
}
